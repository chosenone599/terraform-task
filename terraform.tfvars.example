# Copy this file to terraform.tfvars and fill it in. terraform.tfvars is
# gitignored - never commit real values there.
#
# AWS credentials are NOT set here. Configure them via environment variables
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN), an AWS CLI
# profile (AWS_PROFILE), or an assumed role - see README.

key_name = "<name of an existing EC2 key pair>"

# Restrict this to your own IP (e.g. ["203.0.113.4/32"]) - never 0.0.0.0/0.
ssh_allowed_cidr_blocks = ["<enter your IP>/32"]

# Tagging info, used for asset tagging and billing reconciliation.
environment_tag  = "Joe-POC-env"
billing_code_tag = "1234567890"
